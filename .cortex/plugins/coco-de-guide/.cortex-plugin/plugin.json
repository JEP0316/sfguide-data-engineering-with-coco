{
  "name": "coco-de-guide",
  "version": "1.0.0",
  "description": "Data engineering with CoCo Desktop: dbt model conventions, skills, agents, and hooks for the TPCH dbt project.",
  "author": {
    "name": "Joseph Pruiett",
    "email": "joseph.pruiett@samaritanministries.org"
  },
  "skills": "./skills",
  "agents": "./agents",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "bash",
        "hooks": [
          {
            "type": "command",
            "command": "C:/PROGRA~1/Git/bin/bash.exe C:/VSCodeProjects/Training/DataCampSnowflakeCoCoDesktop/sfguide-data-engineering-with-coco/.cortex/plugins/coco-de-guide/hooks/validate-bash.sh",
            "timeout": 10,
            "enabled": true,
            "statusMessage": "Checking for production dbt runs..."
          }
        ]
      }
    ]
  }
}
